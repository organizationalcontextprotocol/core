{
  "name": "ocp-core",
  "version": "0.5.1",
  "description": "The OCP (Organizational Context Protocol) projection library \u2014 walk a git-native markdown substrate, derive access policy, produce scoped projections, and validate conformance (npx ocp-core validate).",
  "main": "./index.js",
  "bin": {
    "ocp-core": "cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "build:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:types && npm test"
  },
  "license": "MIT",
  "author": "Max Forbang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/organizationalcontextprotocol/core.git"
  },
  "homepage": "https://github.com/organizationalcontextprotocol/core#readme",
  "bugs": "https://github.com/organizationalcontextprotocol/core/issues",
  "keywords": [
    "ocp",
    "organizational-context-protocol",
    "context",
    "markdown",
    "substrate",
    "projection",
    "ai-agents",
    "rbac",
    "multi-tenant",
    "knowledge-base"
  ],
  "files": [
    "index.js",
    "cli.js",
    "types/"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "types": "./types/index.d.ts"
}
